<Project>
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<LangVersion>12.0</LangVersion>
		<PreserveCompilationContext>false</PreserveCompilationContext>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<Nullable>enable</Nullable>
		<!--<GenerateDocumentationFile>True</GenerateDocumentationFile>-->
		<PathMap>$(MSBuildProjectDirectory)=$(MSBuildProjectName)</PathMap>
	</PropertyGroup>

	<!-- NuSpec support for dotnet pack -->
	<PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\$(MSBuildProjectName).nuspec')">
		<NuspecFile>$(MSBuildProjectName).nuspec</NuspecFile>
	</PropertyGroup>

	<!-- Set version after GitVersion runs -->
	<Target Name="SetVersionFromGitVersion" AfterTargets="GetVersion">
		<PropertyGroup>
			<Version>$(GitVersion_Major).$(GitVersion_Minor).$(GitVersion_CommitsSinceVersionSource)</Version>
			<PackageVersion>$(Version)</PackageVersion>
		</PropertyGroup>
		<PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\$(MSBuildProjectName).nuspec')">
			<NuspecProperties>id=$(MSBuildProjectName);version=$(Version)</NuspecProperties>
		</PropertyGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="6.8.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- Phải bump ở ĐÂY, đừng bump bằng PackageReference Update trong một csproj lẻ:
		     TqkLibrary.CompilerServices chảy tiếp sang các project phụ thuộc, nên nâng riêng
		     TqkLibrary.Http là mọi project khác thấy một downgrade (NU1605, mà repo này bật
		     warning-as-error) và cả solution không build được. -->
		<PackageReference Include="TqkLibrary.CompilerServices" Version="1.0.0.3" />
	</ItemGroup>

</Project>