<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\ProjectBuildProperties.targets" />
	<PropertyGroup>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Microsoft.Bcl.HashCode" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="System.Net.Http" />
		<PackageReference Include="TqkLibrary.Utils" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('netstandard2.0'))">
		<!-- VersionOverride vì netstandard2.0 cần nhánh 2.x, mà Directory.Packages.props chỉ khai
		     được MỘT PackageVersion cho mỗi package id (ở đó là bản 8.x cho net8.0). -->
		<PackageReference Include="Microsoft.Net.Http.Headers" VersionOverride="2.3.13" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net8.0'))">
		<PackageReference Include="Microsoft.Net.Http.Headers" />
	</ItemGroup>

</Project>
